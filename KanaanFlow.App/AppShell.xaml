<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KanaanFlow.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:KanaanFlow.App.Pages">

    <!-- License/Welcome flow (no tab bar) -->
    <ShellContent Route="License" ContentTemplate="{DataTemplate pages:LicensePage}" Shell.TabBarIsVisible="False" />
    <ShellContent Route="Welcome" ContentTemplate="{DataTemplate pages:WelcomePage}" Shell.TabBarIsVisible="False" />

    <!-- Main app with tab bar -->
    <TabBar Route="Main">
        <Tab Title="Dashboard" Icon="dotnet_bot.png">
            <ShellContent Route="Dashboard" ContentTemplate="{DataTemplate pages:DashboardPage}" />
        </Tab>
        <Tab Title="Transactions" Icon="dotnet_bot.png">
            <ShellContent Route="Transactions" ContentTemplate="{DataTemplate pages:TransactionListPage}" />
        </Tab>
        <Tab Title="Loans" Icon="dotnet_bot.png">
            <ShellContent Route="Loans" ContentTemplate="{DataTemplate pages:LoanListPage}" />
        </Tab>
        <Tab Title="Reports" Icon="dotnet_bot.png">
            <ShellContent Route="Reports" ContentTemplate="{DataTemplate pages:ReportsPage}" />
        </Tab>
        <Tab Title="Settings" Icon="dotnet_bot.png">
            <ShellContent Route="Settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
        </Tab>
    </TabBar>

</Shell>
