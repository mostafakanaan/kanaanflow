<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KanaanFlow.App.Pages.LicensePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KanaanFlow.App.ViewModels"
    xmlns:loc="clr-namespace:KanaanFlow.App.Localization"
    x:DataType="vm:LicensePageViewModel"
    Title="{loc:Translate License}">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="{loc:Translate EnterLicenseKey}" FontSize="24" FontAttributes="Bold" />
        <Label Text="{loc:Translate PasteAndSave}" />

        <Editor Text="{Binding LicenseKey}"
                AutoSize="TextChanges"
                HeightRequest="120" />

        <Button Text="{loc:Translate Save}" Command="{Binding SaveCommand}" />

        <Label Text="{Binding StatusMessage}" />
    </VerticalStackLayout>
</ContentPage>
