<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:KanaanFlow.App.Localization"
             x:Class="KanaanFlow.App.Pages.SettingsPage"
             Title="{Binding Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">

            <Label Text="{loc:Translate Language}" FontSize="20" FontAttributes="Bold" />
            <Border Padding="12" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
                <Picker ItemsSource="{Binding Languages}"
                        SelectedItem="{Binding SelectedLanguage}" />
            </Border>

            <Label Text="{loc:Translate License}" FontSize="20" FontAttributes="Bold" />
            <Border Padding="12" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
                <Label Text="{Binding LicenseInfo}" />
            </Border>

            <Label Text="{loc:Translate AppInfo}" FontSize="20" FontAttributes="Bold" Margin="0,8,0,0" />
            <Border Padding="12" BackgroundColor="#F5F5F5" StrokeShape="RoundRectangle 8">
                <VerticalStackLayout Spacing="8">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Version}" />
                        <Label Grid.Column="1" Text="{Binding AppVersion}" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate App}" />
                        <Label Grid.Column="1" Text="KanaanFlow" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="{loc:Translate Author}" />
                        <Label Grid.Column="1" Text="Mustafa Kanaan" FontAttributes="Bold" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
