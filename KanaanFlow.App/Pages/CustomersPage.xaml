<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KanaanFlow.App.Pages.CustomersPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:KanaanFlow.App.ViewModels"
    x:DataType="viewmodels:CustomersViewModel"
    Title="Customers"
    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="16">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0">
            <Label Text="Customer Management" 
                   FontSize="24" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
            <Label Text="Manage and view all your customers" 
                   FontSize="14" 
                   TextColor="{StaticResource Gray500}" />
        </VerticalStackLayout>

        <!-- Search and Filter Bar -->
        <Frame Grid.Row="1" 
               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
               CornerRadius="12"
               Padding="12"
               BorderColor="Transparent"
               HasShadow="True">
            <Grid ColumnDefinitions="*,Auto">
                <SearchBar Placeholder="Search customers..." 
                           BackgroundColor="Transparent"
                           Text="{Binding SearchText}"
                           SearchCommand="{Binding SearchCommand}" />
                <Button Grid.Column="1" 
                        Text="+ Add" 
                        BackgroundColor="{StaticResource Primary}"
                        TextColor="White"
                        CornerRadius="8"
                        Padding="16,8"
                        Command="{Binding AddCustomerCommand}" />
            </Grid>
        </Frame>

        <!-- Table Header -->
        <Frame Grid.Row="2"
               BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
               CornerRadius="16"
               Padding="0"
               BorderColor="Transparent"
               HasShadow="True">
            <VerticalStackLayout>
                <!-- Table Header Row -->
                <Grid ColumnDefinitions="60,2*,2*,1.5*,1*,80" 
                      Padding="16,12"
                      BackgroundColor="{StaticResource Primary}">
                    <Label Grid.Column="0" Text="ID" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="Name" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    <Label Grid.Column="2" Text="Email" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    <Label Grid.Column="3" Text="Phone" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    <Label Grid.Column="4" Text="Status" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    <Label Grid.Column="5" Text="Actions" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" HorizontalOptions="Center" />
                </Grid>

                <!-- Table Content -->
                <CollectionView ItemsSource="{Binding Customers}" 
                                SelectionMode="None">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:CustomerItem">
                            <Grid ColumnDefinitions="60,2*,2*,1.5*,1*,80" 
                                  Padding="16,14"
                                  BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                                <Label Grid.Column="0" 
                                       Text="{Binding Id}" 
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                
                                <HorizontalStackLayout Grid.Column="1" Spacing="10" VerticalOptions="Center">
                                    <Frame CornerRadius="20" 
                                           HeightRequest="40" 
                                           WidthRequest="40" 
                                           Padding="0"
                                           BackgroundColor="{Binding AvatarColor}"
                                           BorderColor="Transparent">
                                        <Label Text="{Binding Initials}" 
                                               FontAttributes="Bold"
                                               TextColor="White"
                                               HorizontalOptions="Center" 
                                               VerticalOptions="Center" />
                                    </Frame>
                                    <Label Text="{Binding Name}" 
                                           FontAttributes="Bold"
                                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                
                                <Label Grid.Column="2" 
                                       Text="{Binding Email}" 
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                
                                <Label Grid.Column="3" 
                                       Text="{Binding Phone}" 
                                       TextColor="{StaticResource Gray500}"
                                       VerticalOptions="Center" />
                                
                                <Frame Grid.Column="4" 
                                       CornerRadius="8"
                                       Padding="8,4"
                                       BackgroundColor="{Binding StatusColor}"
                                       BorderColor="Transparent"
                                       HorizontalOptions="Start"
                                       VerticalOptions="Center">
                                    <Label Text="{Binding Status}" 
                                           FontSize="12"
                                           TextColor="{Binding StatusTextColor}" />
                                </Frame>
                                
                                <HorizontalStackLayout Grid.Column="5" 
                                                       Spacing="8" 
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center">
                                    <Button Text="Edit" 
                                            BackgroundColor="{StaticResource Secondary}"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="12"
                                            Padding="8,4"
                                            CornerRadius="6"
                                            HeightRequest="30"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:CustomersViewModel}}, Path=EditCommand}"
                                            CommandParameter="{Binding}" />
                                </HorizontalStackLayout>
                            </Grid>
                            
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
                
                <!-- Summary Footer -->
                <Grid ColumnDefinitions="*,Auto" 
                      Padding="16,12"
                      BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}">
                    <Label Text="{Binding TotalCustomersText}" 
                           TextColor="{StaticResource Gray500}"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Frame>
    </Grid>
</ContentPage>
