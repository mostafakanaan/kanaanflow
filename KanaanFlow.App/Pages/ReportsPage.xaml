<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KanaanFlow.App.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:KanaanFlow.App.ViewModels"
    x:DataType="viewmodels:ReportsViewModel"
    Title="Reports"
    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <ScrollView>
        <VerticalStackLayout Padding="16" Spacing="16">
        
            <!-- Header -->
            <VerticalStackLayout>
                <Label Text="Reports Dashboard" 
                       FontSize="24" 
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                <Label Text="Analytics and insights for your business" 
                       FontSize="14" 
                       TextColor="{StaticResource Gray500}" />
            </VerticalStackLayout>

            <!-- Quick Stats Cards -->
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
                <Frame Grid.Column="0"
                       BackgroundColor="#667eea"
                       CornerRadius="12"
                       Padding="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="$124,500" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Total Revenue" FontSize="11" TextColor="#ffffffaa" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="1"
                       BackgroundColor="#17a2b8"
                       CornerRadius="12"
                       Padding="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="156" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Customers" FontSize="11" TextColor="#ffffffaa" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="2"
                       BackgroundColor="#28a745"
                       CornerRadius="12"
                       Padding="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="+23%" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Growth" FontSize="11" TextColor="#ffffffaa" />
                    </VerticalStackLayout>
                </Frame>
                <Frame Grid.Column="3"
                       BackgroundColor="#fd7e14"
                       CornerRadius="12"
                       Padding="16"
                       BorderColor="Transparent"
                       HasShadow="True">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="24" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="Partners" FontSize="11" TextColor="#ffffffaa" />
                    </VerticalStackLayout>
                </Frame>
            </Grid>

            <!-- Recent Reports Table -->
            <Label Text="Recent Reports" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}"
                   Margin="0,8,0,0" />

            <Frame BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}"
                   CornerRadius="16"
                   Padding="0"
                   BorderColor="Transparent"
                   HasShadow="True">
                <VerticalStackLayout>
                    <!-- Table Header -->
                    <Grid ColumnDefinitions="2*,1.5*,1*,1*,80" 
                          Padding="16,12"
                          BackgroundColor="{StaticResource Primary}">
                        <Label Grid.Column="0" Text="Report Name" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="1" Text="Type" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="2" Text="Date" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="3" Text="Status" FontAttributes="Bold" TextColor="White" />
                        <Label Grid.Column="4" Text="Actions" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    </Grid>

                    <!-- Table Rows -->
                    <CollectionView ItemsSource="{Binding Reports}" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:ReportItem">
                                <Grid ColumnDefinitions="2*,1.5*,1*,1*,80" 
                                      Padding="16,14"
                                      BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource OffBlack}}">
                                    <VerticalStackLayout Grid.Column="0" VerticalOptions="Center">
                                        <Label Text="{Binding Name}" 
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding Description}" 
                                               FontSize="11"
                                               TextColor="{StaticResource Gray500}" />
                                    </VerticalStackLayout>
                                    
                                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                                        <Frame CornerRadius="4" 
                                               Padding="6,2"
                                               BackgroundColor="{Binding TypeColor}"
                                               BorderColor="Transparent">
                                            <Label Text="{Binding Type}" 
                                                   FontSize="11"
                                                   TextColor="White" />
                                        </Frame>
                                    </HorizontalStackLayout>
                                    
                                    <Label Grid.Column="2" 
                                           Text="{Binding Date}" 
                                           TextColor="{StaticResource Gray500}"
                                           VerticalOptions="Center" />
                                    
                                    <Frame Grid.Column="3" 
                                           CornerRadius="8"
                                           Padding="8,4"
                                           BackgroundColor="{Binding StatusColor}"
                                           BorderColor="Transparent"
                                           HorizontalOptions="Start"
                                           VerticalOptions="Center">
                                        <Label Text="{Binding Status}" 
                                               FontSize="11"
                                               TextColor="{Binding StatusTextColor}" />
                                    </Frame>
                                    
                                    <Button Grid.Column="4" 
                                            Text="View"
                                            BackgroundColor="{StaticResource Secondary}"
                                            TextColor="{StaticResource Primary}"
                                            FontSize="12"
                                            Padding="12,4"
                                            CornerRadius="6"
                                            HeightRequest="30"
                                            HorizontalOptions="Center"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ReportsViewModel}}, Path=ViewReportCommand}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Generate Report Button -->
            <Button Text="Generate New Report"
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    CornerRadius="12"
                    Padding="20,14"
                    FontAttributes="Bold"
                    Command="{Binding GenerateReportCommand}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
