<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KanaanFlow.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:KanaanFlow.App.ViewModels"
    x:DataType="vm:WelcomePageViewModel"
    Title="Welcome">

    <VerticalStackLayout Padding="16" Spacing="12">
        <Label Text="Welcome" FontSize="28" FontAttributes="Bold" />
        <Label Text="{Binding Customer}" FontSize="18" />
        <Label Text="{Binding ValidUntil}" FontSize="16" />
    </VerticalStackLayout>
</ContentPage>
