<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KanaanFlow.App.Pages.WelcomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewmodels="clr-namespace:KanaanFlow.App.ViewModels"
    x:DataType="viewmodels:DashboardViewModel"
    Title="Dashboard"
    BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray900}}">

    <Grid RowDefinitions="Auto,*,Auto" Padding="20" RowSpacing="20">
        
        <!-- HEADER with Gradient -->
        <Border Grid.Row="0"
                StrokeThickness="0"
                Stroke="Transparent">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="{StaticResource Primary}" Offset="0.0" />
                    <GradientStop Color="#764BA2" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>
            <Border.Shadow>
                <Shadow Brush="{StaticResource Primary}" 
                        Opacity="0.3" 
                        Radius="20" 
                        Offset="0,8" />
            </Border.Shadow>
            <Grid ColumnDefinitions="Auto,*,Auto" Padding="20">
                <Border StrokeThickness="3"
                        Stroke="White"
                        HeightRequest="60"
                        WidthRequest="60"
                        Opacity="0.9">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="30"/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="White" Offset="0.0" />
                            <GradientStop Color="#E8E8E8" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Label Text="K" 
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Border>
                <VerticalStackLayout Grid.Column="1" Padding="16,0" VerticalOptions="Center">
                    <Label Text="Welcome back," 
                           FontSize="14" 
                           TextColor="White"
                           Opacity="0.8" />
                    <Label x:Name="CustomerLabel" 
                           FontSize="22" 
                           FontAttributes="Bold"
                           TextColor="White" />
                </VerticalStackLayout>
                <Border Grid.Column="2"
                        StrokeThickness="2"
                        Stroke="White"
                        Opacity="0.6"
                        HeightRequest="44"
                        WidthRequest="44"
                        VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="22"/>
                    </Border.StrokeShape>
                    <Label Text="⚙" 
                           FontSize="20"
                           TextColor="White"
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- MENU GRID with Enhanced Styling -->
        <ScrollView Grid.Row="1">
            <Grid ColumnDefinitions="*,*,*" 
                  RowDefinitions="Auto,Auto" 
                  ColumnSpacing="16" 
                  RowSpacing="16">
                
                <!-- Reports -->
                <Border Grid.Row="0" Grid.Column="0"
                        StrokeThickness="0"
                        HeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#667eea" Offset="0.0" />
                            <GradientStop Color="#764ba2" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#667eea" Opacity="0.4" Radius="15" Offset="0,8" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToReportsCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Border StrokeThickness="0"
                                HeightRequest="48"
                                WidthRequest="48"
                                BackgroundColor="White"
                                Opacity="0.95">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="📊" FontSize="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Reports" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Customers -->
                <Border Grid.Row="0" Grid.Column="1"
                        StrokeThickness="0"
                        HeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#11998e" Offset="0.0" />
                            <GradientStop Color="#38ef7d" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#11998e" Opacity="0.4" Radius="15" Offset="0,8" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToCustomersCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Border StrokeThickness="0"
                                HeightRequest="48"
                                WidthRequest="48"
                                BackgroundColor="White"
                                Opacity="0.95">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="👥" FontSize="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Customers" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Partners -->
                <Border Grid.Row="0" Grid.Column="2"
                        StrokeThickness="0"
                        HeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#f2994a" Offset="0.0" />
                            <GradientStop Color="#f2c94c" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#f2994a" Opacity="0.4" Radius="15" Offset="0,8" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToPartnersCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Border StrokeThickness="0"
                                HeightRequest="48"
                                WidthRequest="48"
                                BackgroundColor="White"
                                Opacity="0.95">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="🤝" FontSize="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Partners" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Family -->
                <Border Grid.Row="1" Grid.Column="0"
                        StrokeThickness="0"
                        HeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#eb3349" Offset="0.0" />
                            <GradientStop Color="#f45c43" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#eb3349" Opacity="0.4" Radius="15" Offset="0,8" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFamilyCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Border StrokeThickness="0"
                                HeightRequest="48"
                                WidthRequest="48"
                                BackgroundColor="White"
                                Opacity="0.95">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="👨‍👩‍👧‍👦" FontSize="20"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Family" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Currency -->
                <Border Grid.Row="1" Grid.Column="1"
                        StrokeThickness="0"
                        HeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#56ab2f" Offset="0.0" />
                            <GradientStop Color="#a8e063" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#56ab2f" Opacity="0.4" Radius="15" Offset="0,8" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToCurrencyCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Border StrokeThickness="0"
                                HeightRequest="48"
                                WidthRequest="48"
                                BackgroundColor="White"
                                Opacity="0.95">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="💱" FontSize="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Currency" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>

                <!-- Notes -->
                <Border Grid.Row="1" Grid.Column="2"
                        StrokeThickness="0"
                        HeightRequest="120">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16"/>
                    </Border.StrokeShape>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#4568DC" Offset="0.0" />
                            <GradientStop Color="#B06AB3" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.Shadow>
                        <Shadow Brush="#4568DC" Opacity="0.4" Radius="15" Offset="0,8" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToNotesCommand}" />
                    </Border.GestureRecognizers>
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                        <Border StrokeThickness="0"
                                HeightRequest="48"
                                WidthRequest="48"
                                BackgroundColor="White"
                                Opacity="0.95">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12"/>
                            </Border.StrokeShape>
                            <Label Text="📝" FontSize="24"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Text="Notes" 
                               FontSize="14" 
                               FontAttributes="Bold"
                               TextColor="White" />
                    </VerticalStackLayout>
                </Border>
            </Grid>
        </ScrollView>

        <!-- STATS FOOTER with Glass Effect -->
        <Border Grid.Row="2"
                StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light=White, Dark={StaticResource OffBlack}}"
                Opacity="0.95">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="20"/>
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="Black" Opacity="0.1" Radius="20" Offset="0,4" />
            </Border.Shadow>
            <Grid ColumnDefinitions="*,*,*,*" Padding="16,12" ColumnSpacing="12">
                <!-- Customers Stat -->
                <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                    <Border StrokeThickness="0"
                            HeightRequest="40"
                            WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E3F2FD" Offset="0.0" />
                                <GradientStop Color="#BBDEFB" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="👥" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="156" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                    <Label Text="Customers" 
                           FontSize="10" 
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>

                <!-- Partners Stat -->
                <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center" Spacing="4">
                    <Border StrokeThickness="0"
                            HeightRequest="40"
                            WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFF3E0" Offset="0.0" />
                                <GradientStop Color="#FFE0B2" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="🤝" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="24" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                    <Label Text="Partners" 
                           FontSize="10" 
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>

                <!-- Family Stat -->
                <VerticalStackLayout Grid.Column="2" HorizontalOptions="Center" Spacing="4">
                    <Border StrokeThickness="0"
                            HeightRequest="40"
                            WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FCE4EC" Offset="0.0" />
                                <GradientStop Color="#F8BBD0" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="👨‍👩‍👧‍👦" FontSize="16"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="42" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                    <Label Text="Family" 
                           FontSize="10" 
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>

                <!-- Reports Stat -->
                <VerticalStackLayout Grid.Column="3" HorizontalOptions="Center" Spacing="4">
                    <Border StrokeThickness="0"
                            HeightRequest="40"
                            WidthRequest="40">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="10"/>
                        </Border.StrokeShape>
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#E8F5E9" Offset="0.0" />
                                <GradientStop Color="#C8E6C9" Offset="1.0" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Label Text="📊" FontSize="18"
                               HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>
                    <Label Text="12" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark=White}" />
                    <Label Text="Reports" 
                           FontSize="10" 
                           TextColor="{StaticResource Gray500}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
