{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanaanflow-flow",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  // The PWA from `dotnet publish KanaanFlow.Web` (its wwwroot), copied here by the deploy workflow.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // No /index.html -> / redirect: the service worker caches index.html, and Safari won't show a cached redirect.
    "html_handling": "none",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/service-worker-assets.js"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "kanaanflow",
      "database_id": "704e879d-bd07-4fad-a041-5edeb21edc54",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
