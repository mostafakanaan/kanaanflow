@page "/welcome"
@layout FlowLayout
@inherits KfComponent
@inject SyncService Sync
@inject ApiClient Api
@inject LocalAuth Local

<PageTitle>KanaanFlow</PageTitle>
<div class="lang-pick">
    <button type="button" class="lang-btn" aria-label="@T("language")" aria-haspopup="menu" aria-expanded="@(langOpen ? "true" : "false")" @onclick="() => langOpen = !langOpen">
        <Flag Country="@FlagFor(Lang)" Size="20" />
        <Icon Name="chevron" Size="16" Class="chev-down" />
    </button>
    @if (langOpen)
    {
        <div class="lang-menu" role="menu">
            @foreach ((string Code, string Name) l in Languages)
            {
                string code = l.Code;
                <button type="button" role="menuitemradio" aria-label="@l.Name" aria-checked="@(Lang == code ? "true" : "false")" @onclick="() => SetLanguage(code)"><Flag Country="@FlagFor(code)" Size="22" /></button>
            }
        </div>
    }
</div>

<div class="welcome">
    <BrandMark Class="logo" />
    <h1>@T("welcomeTitle")</h1>
    <p>@T("welcomeText")</p>

    <div class="grid-2" role="group">
        <button type="button" class="sel tile" aria-pressed="@(!creating ? "true" : "false")" @onclick="() => Switch(false, false)"><Icon Name="user" Size="20" />&nbsp;@T("signIn")</button>
        <button type="button" class="sel tile" aria-pressed="@(creating ? "true" : "false")" @onclick="() => Switch(true, false)"><Icon Name="plus" Size="20" />&nbsp;@T("createUser")</button>
    </div>

    @if (serverReady == null && checkedServer)
    {
        <p class="notice">@T("noServerLocal")</p>
    }

    @if (resetting)
    {
        <p class="notice">@T("resetPasswordHint")</p>
    }

    <label class="field">@T("yourName")
        <input class="input" type="text" @bind="name" @bind:event="oninput" placeholder="@T("yourNamePh")" autocomplete="username" />
    </label>
    <label class="field">@(resetting ? T("newPassword") : T("password"))
        <input class="input" type="password" @bind="password" autocomplete="@(creating || resetting ? "new-password" : "current-password")" />
    </label>

    @if (creating || resetting)
    {
        <label class="field">@T("repeatPassword")
            <input class="input" type="password" @bind="repeat" autocomplete="new-password" />
        </label>
        <label class="field">@T("masterPassword")
            <input class="input" type="password" @bind="master" autocomplete="off" />
        </label>
        @if (creating)
        {
            <p class="muted small">@T("createUserHint")</p>
        }
    }
    else
    {
        <button type="button" class="link-btn" style="align-self:flex-start;margin-top:-12px" @onclick="() => Switch(false, true)">@T("forgotPassword")</button>
    }

    @if (error.Length > 0)
    {
        <p class="err-text" style="text-align:start" role="alert">@error</p>
    }

    <button type="button" class="btn btn-primary btn-block" style="height:64px;font-size:22px;border-radius:18px" disabled="@(busy || !checkedServer)" @onclick="StartAsync">@(creating ? T("createUser") : resetting ? T("resetPasswordTitle") : T("signIn"))</button>

    @if (resetting)
    {
        <button type="button" class="link-btn" style="align-self:center" @onclick="() => Switch(false, false)">@T("cancel")</button>
    }
</div>

@code {
    private string name = string.Empty;
    private string password = string.Empty;
    private string repeat = string.Empty;
    private string master = string.Empty;
    private string error = string.Empty;
    private bool creating;
    private bool resetting;
    private bool checkedServer;
    private bool? serverReady;
    private bool busy;
    private bool langOpen;

    private static readonly (string Code, string Name)[] Languages = { ("ar", "العربية"), ("en", "English") };

    private static string FlagFor(string language) => language == "en" ? "US" : "SA";

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        if (Books.IsLoggedIn)
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        // A server without users yet, or a device with no users of its own: creating the first user is the likely choice.
        serverReady = await Api.IsReadyAsync();
        creating = serverReady == false || (serverReady == null && Books.Settings.LocalAccounts.Count == 0);
        checkedServer = true;
    }

    private void Switch(bool create, bool reset)
    {
        creating = create;
        resetting = reset;
        error = string.Empty;
    }

    private async Task SetLanguage(string language)
    {
        langOpen = false;
        Books.Settings.Language = language;
        await Books.SaveSettingsAsync();
    }

    private async Task StartAsync()
    {
        busy = true;
        error = string.Empty;
        string trimmed = name.Trim();
        try
        {
            if ((creating || resetting) && password != repeat)
            {
                error = T("passwordsDiffer");
                return;
            }

            string? failure = null;
            if (serverReady != null)
            {
                if (creating)
                {
                    await Sync.RegisterAsync(trimmed, password, master);
                }
                else if (resetting)
                {
                    await Sync.ResetPasswordAsync(trimmed, master, password);
                }
                else
                {
                    await Sync.SignInAsync(trimmed, password);
                }
            }
            else
            {
                failure = creating
                    ? await Local.RegisterAsync(trimmed, password, master)
                    : resetting
                    ? await Local.ResetPasswordAsync(trimmed, password, master)
                    : await Local.SignInAsync(trimmed, password);
            }

            if (failure != null)
            {
                error = ErrorText.For(Books, failure);
                return;
            }

            password = repeat = master = string.Empty;
            Toasts.Show(creating ? T("userCreated") : resetting ? T("passwordReset") : T("signedIn"));
            Nav.NavigateTo("", replace: true);
        }
        catch (ApiException ex)
        {
            error = ErrorText.For(Books, ex.Code);
        }
        catch (HttpRequestException)
        {
            error = T("noConnection");
        }
        finally
        {
            busy = false;
        }
    }
}
