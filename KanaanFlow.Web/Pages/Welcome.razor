@page "/welcome"
@layout FlowLayout
@inherits KfComponent
@inject SyncService Sync
@inject ApiClient Api

<PageTitle>KanaanFlow</PageTitle>
<div class="welcome">
    <BrandMark Class="logo" />
    <h1>@T("welcomeTitle")</h1>
    <p>@T("welcomeText")</p>

    <div class="grid-2" role="group" aria-label="@T("language")">
        <button type="button" class="sel tile" aria-pressed="@(Lang == "ar" ? "true" : "false")" @onclick='() => SetLanguage("ar")'>العربية</button>
        <button type="button" class="sel tile" aria-pressed="@(Lang == "en" ? "true" : "false")" @onclick='() => SetLanguage("en")'>English</button>
    </div>

    @if (teamBookExists)
    {
        <div class="grid-2" role="group">
            <button type="button" class="sel tile" aria-pressed="@(joining ? "true" : "false")" @onclick="() => joining = true">@T("joinTeam")</button>
            <button type="button" class="sel tile" aria-pressed="@(!joining ? "true" : "false")" @onclick="() => joining = false">@T("newBook")</button>
        </div>
    }

    <label class="field">@T("yourName")
        <input class="input" type="text" @bind="name" @bind:event="oninput" placeholder="@T("yourNamePh")" autocomplete="username" />
    </label>

    @if (joining)
    {
        <label class="field">@T("password")
            <input class="input" type="password" @bind="password" autocomplete="current-password" />
        </label>
    }
    else if (!teamBookExists)
    {
        <p class="muted small">@T("joinHint")</p>
    }

    @if (error.Length > 0)
    {
        <p class="err-text" style="text-align:start" role="alert">@error</p>
    }

    <button type="button" class="btn btn-primary btn-block" style="height:64px;font-size:22px;border-radius:18px" disabled="@busy" @onclick="StartAsync">@(joining ? T("signIn") : T("start"))</button>
</div>

@code {
    private string name = string.Empty;
    private string password = string.Empty;
    private string error = string.Empty;
    private bool joining;
    private bool teamBookExists;
    private bool busy;

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        if (Books.Settings.SetupDone)
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        // When this address has a team book, joining it is the likely choice.
        teamBookExists = await Api.IsReadyAsync() == true;
        joining = teamBookExists;
    }

    private async Task SetLanguage(string language)
    {
        Books.Settings.Language = language;
        await Books.SaveSettingsAsync();
    }

    private async Task StartAsync()
    {
        busy = true;
        error = string.Empty;
        try
        {
            if (joining)
            {
                await Sync.SignInAsync(name.Trim(), password);
            }
            else
            {
                TeamMember me = new TeamMember { Id = BookService.NewId(), Name = name.Trim(), Role = TeamRole.Owner };
                Books.Settings.MemberId = me.Id;
                await Books.RecordAsync(new MemberSaved { Member = me });
            }

            Books.Settings.SetupDone = true;
            await Books.SaveSettingsAsync();
            Nav.NavigateTo("", replace: true);
        }
        catch (ApiException ex)
        {
            string key = "err-" + ex.Code;
            error = T(key) == key ? T("err-server-error") : T(key);
        }
        catch (HttpRequestException)
        {
            error = T("noConnection");
        }
        finally
        {
            busy = false;
        }
    }
}
