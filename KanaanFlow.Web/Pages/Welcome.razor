@page "/welcome"
@layout FlowLayout
@inherits KfComponent
@inject SyncService Sync
@inject ApiClient Api
@inject LocalAuth Local

<PageTitle>KanaanFlow</PageTitle>
<div class="lang-pick">
    <button type="button" class="lang-btn" aria-label="@T("language")" aria-haspopup="menu" aria-expanded="@(langOpen ? "true" : "false")" @onclick="() => langOpen = !langOpen">
        <Flag Country="@FlagFor(Lang)" Size="20" />
        <Icon Name="chevron" Size="16" Class="chev-down" />
    </button>
    @if (langOpen)
    {
        <div class="lang-menu" role="menu">
            @foreach ((string Code, string Name) l in Languages)
            {
                string code = l.Code;
                <button type="button" role="menuitemradio" aria-label="@l.Name" aria-checked="@(Lang == code ? "true" : "false")" @onclick="() => SetLanguage(code)"><Flag Country="@FlagFor(code)" Size="22" /></button>
            }
        </div>
    }
</div>

<div class="welcome">
    <BrandMark Class="logo" />
    <h1>@T("welcomeTitle")</h1>
    <p>@T("welcomeText")</p>

    <div class="grid-2" role="group">
        <button type="button" class="sel tile" aria-pressed="@(mode != Mode.Create ? "true" : "false")" @onclick="() => Switch(Mode.SignIn)"><Icon Name="user" Size="20" />&nbsp;@T("signIn")</button>
        <button type="button" class="sel tile" aria-pressed="@(mode == Mode.Create ? "true" : "false")" @onclick="() => Switch(Mode.Create)"><Icon Name="plus" Size="20" />&nbsp;@T("createUser")</button>
    </div>

    @if (serverReady == null && checkedServer)
    {
        <p class="notice">@T("noServerLocal")</p>
    }

    @if (mode == Mode.Reset)
    {
        <p class="notice">@T(serverReady == null ? "resetPasswordHintLocal" : "resetPasswordHint")</p>
    }

    <label class="field">@T("yourName")
        <input class="input" type="text" @bind="name" @bind:event="oninput" placeholder="@T("yourNamePh")" autocomplete="username" />
    </label>
    <label class="field">@(mode == Mode.Reset ? T("newPassword") : T("password"))
        <input class="input" type="password" @bind="password" autocomplete="@(mode == Mode.SignIn ? "current-password" : "new-password")" />
    </label>

    @if (mode != Mode.SignIn)
    {
        <label class="field">@T("repeatPassword")
            <input class="input" type="password" @bind="repeat" autocomplete="new-password" />
        </label>
        <label class="field">@T("masterPassword")
            <input class="input" type="password" @bind="master" autocomplete="off" />
        </label>
        @if (mode == Mode.Create)
        {
            <p class="muted small">@T("createUserHint")</p>
        }
    }
    else if (CanReset)
    {
        <button type="button" class="link-btn" style="align-self:flex-start;margin-top:-12px" @onclick="() => Switch(Mode.Reset)">@T("forgotPassword")</button>
    }

    @if (error.Length > 0)
    {
        <p class="err-text" style="text-align:start" role="alert">@error</p>
    }

    <button type="button" class="btn btn-primary btn-block" style="height:64px;font-size:22px;border-radius:18px" disabled="@(busy || !checkedServer)" @onclick="StartAsync">@T(mode == Mode.Create ? "createUser" : mode == Mode.Reset ? "resetPasswordTitle" : "signIn")</button>

    @if (mode == Mode.Reset)
    {
        <button type="button" class="link-btn" style="align-self:center" @onclick="() => Switch(Mode.SignIn)">@T("cancel")</button>
    }
</div>

@code {
    private string name = string.Empty;
    private string password = string.Empty;
    private string repeat = string.Empty;
    private string master = string.Empty;
    private string error = string.Empty;
    private Mode mode = Mode.SignIn;
    private bool checkedServer;
    private bool? serverReady;
    private bool busy;
    private bool langOpen;

    private static readonly (string Code, string Name)[] Languages = { ("ar", "العربية"), ("en", "English") };

    private static string FlagFor(string language) => language == "en" ? "US" : "SA";

    protected override async Task OnInitializedAsync()
    {
        base.OnInitialized();
        if (Books.IsLoggedIn)
        {
            Nav.NavigateTo("", replace: true);
            return;
        }

        // A server without users yet, or a device with no users of its own: creating the first user is the likely choice.
        serverReady = await Api.IsReadyAsync();
        mode = CanReset ? Mode.SignIn : Mode.Create;
        checkedServer = true;
    }

    private enum Mode
    {
        SignIn,
        Create,
        Reset
    }

    /// <summary>There is someone to sign in or reset: a server with users, or users on this device.</summary>
    private bool CanReset => serverReady == true || (serverReady == null && Books.Settings.LocalAccounts.Count > 0);

    private void Switch(Mode next)
    {
        mode = next;
        error = string.Empty;
    }

    private async Task SetLanguage(string language)
    {
        langOpen = false;
        Books.Settings.Language = language;
        await Books.SaveSettingsAsync();
    }

    private async Task StartAsync()
    {
        busy = true;
        error = string.Empty;
        string trimmed = name.Trim();
        try
        {
            if (mode != Mode.SignIn && password != repeat)
            {
                error = T("passwordsDiffer");
                return;
            }

            string? failure = null;
            if (serverReady != null)
            {
                if (mode == Mode.Create)
                {
                    await Sync.RegisterAsync(trimmed, password, master);
                }
                else if (mode == Mode.Reset)
                {
                    await Sync.ResetPasswordAsync(trimmed, master, password);
                }
                else
                {
                    await Sync.SignInAsync(trimmed, password);
                }
            }
            else
            {
                failure = mode == Mode.Create
                    ? await Local.RegisterAsync(trimmed, password, master)
                    : mode == Mode.Reset
                    ? await Local.ResetPasswordAsync(trimmed, master, password)
                    : await Local.SignInAsync(trimmed, password);
            }

            if (failure != null)
            {
                error = ErrorText.For(Books, failure);
                return;
            }

            password = repeat = master = string.Empty;
            Toasts.Show(T(mode == Mode.Create ? "userCreated" : mode == Mode.Reset ? "passwordReset" : "signedIn"));
            Nav.NavigateTo("", replace: true);
        }
        catch (ApiException ex)
        {
            error = ErrorText.For(Books, ex.Code);
        }
        catch (HttpRequestException)
        {
            error = T("noConnection");
        }
        finally
        {
            busy = false;
        }
    }
}
