@page "/welcome"
@layout FlowLayout
@inherits KfComponent
@inject SyncService Sync

<PageTitle>KanaanFlow</PageTitle>
<div class="welcome">
    <BrandMark Class="logo" />
    <h1>@T("welcomeTitle")</h1>
    <p>@T("welcomeText")</p>

    <div class="grid-2" role="group" aria-label="@T("language")">
        <button type="button" class="sel tile" aria-pressed="@(Lang == "ar" ? "true" : "false")" @onclick='() => SetLanguage("ar")'>العربية</button>
        <button type="button" class="sel tile" aria-pressed="@(Lang == "en" ? "true" : "false")" @onclick='() => SetLanguage("en")'>English</button>
    </div>

    <label class="field">@T("yourName")
        <input class="input" type="text" @bind="name" @bind:event="oninput" placeholder="@T("yourNamePh")" autocomplete="name" />
    </label>

    <button type="button" class="sel tile" aria-pressed="@(joining ? "true" : "false")" @onclick="() => joining = !joining">@T("syncSetup")</button>
    @if (joining)
    {
        <p class="muted small">@T("bookCodeHint")</p>
        <label class="field">@T("syncUrl")
            <input class="input ltr" type="url" @bind="syncUrl" placeholder="https://xxxx.supabase.co" autocomplete="off" />
        </label>
        <label class="field">@T("syncKey")
            <input class="input ltr" type="text" @bind="syncKey" autocomplete="off" />
        </label>
        <label class="field">@T("bookCode")
            <input class="input ltr" type="text" @bind="bookCode" autocomplete="off" />
        </label>
    }
    else
    {
        <p class="muted small">@T("joinHint")</p>
    }

    <button type="button" class="btn btn-primary btn-block" style="height:64px;font-size:22px;border-radius:18px" disabled="@busy" @onclick="StartAsync">@T("start")</button>
</div>

@code {
    private string name = string.Empty;
    private bool joining;
    private bool busy;
    private string syncUrl = string.Empty;
    private string syncKey = string.Empty;
    private string bookCode = string.Empty;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        if (Books.Settings.SetupDone)
        {
            Nav.NavigateTo("", replace: true);
        }
    }

    private async Task SetLanguage(string language)
    {
        Books.Settings.Language = language;
        await Books.SaveSettingsAsync();
    }

    private async Task StartAsync()
    {
        busy = true;
        string trimmed = name.Trim();
        bool joined = false;
        if (joining && syncUrl.Trim().Length > 0 && syncKey.Trim().Length > 0 && bookCode.Trim().Length > 0)
        {
            await Sync.ConfigureAsync(syncUrl, syncKey, bookCode);
            joined = Book.Members.Count > 0;
        }

        TeamMember? existing = trimmed.Length == 0
            ? null
            : Book.Members.FirstOrDefault(m => string.Equals(m.Name.Trim(), trimmed, StringComparison.OrdinalIgnoreCase));

        if (existing != null)
        {
            Books.Settings.MemberId = existing.Id;
        }
        else
        {
            TeamMember me = new TeamMember
            {
                Id = BookService.NewId(),
                Name = trimmed,
                Role = joined ? TeamRole.Staff : TeamRole.Owner
            };
            Books.Settings.MemberId = me.Id;
            await Books.RecordAsync(new MemberSaved { Member = me });
        }

        Books.Settings.SetupDone = true;
        await Books.SaveSettingsAsync();
        Nav.NavigateTo("", replace: true);
    }
}
