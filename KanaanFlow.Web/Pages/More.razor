@page "/more"
@inherits KfComponent

<PageTitle>@T("moreTitle") · KanaanFlow</PageTitle>
<h1 class="h1">@T("moreTitle")</h1>

<nav class="hub" aria-label="@T("moreTitle")">
    @foreach ((string Href, string Icon, string Title, string Sub) tile in Tiles)
    {
        <a class="hub-tile" href="@tile.Href">
            <span class="hub-ic"><Icon Name="@tile.Icon" Size="28" /></span>
            <span class="hub-text"><b>@T(tile.Title)</b><span>@T(tile.Sub)</span></span>
            @if (tile.Href == "more/deleted" && Book.DeletedEntries.Count > 0)
            {
                <span class="count-pill">@Book.DeletedEntries.Count</span>
            }
            <Icon Name="chevron" Size="20" Class="flip hub-go" />
        </a>
    }
</nav>

@code {
    /// <summary>The settings, grouped. The admin panel shows only for Admins.</summary>
    private IEnumerable<(string Href, string Icon, string Title, string Sub)> Tiles
    {
        get
        {
            yield return ("more/users", "people", "tileUsers", "tileUsersSub");
            if (Books.CanManageBook)
            {
                yield return ("salaries", "wallet", "salaries", "salariesSub");
            }

            yield return ("more/categories", "tag", "tileCategories", "tileCategoriesSub");
            yield return ("more/entities", "folder", "tileEntities", "tileEntitiesSub");
            yield return ("more/balances", "wallet", "tileBalances", "tileBalancesSub");
            yield return ("more/app", "settings", "tileApp", "tileAppSub");
            if (Books.CanDelete)
            {
                yield return ("more/deleted", "trash", "deletedEntries", "deletedEntriesSub");
            }

            if (Books.IsAdmin)
            {
                yield return ("more/admin", "shield", "adminPanel", "adminPanelSub");
            }
        }
    }
}
