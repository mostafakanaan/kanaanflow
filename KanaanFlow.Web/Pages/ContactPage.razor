@page "/people/{Id}"
@inherits KfComponent
@inject ExportService Export

@if (contact == null)
{
    <a class="back-link" href="people"><Icon Name="back" Class="flip" Stroke="2.2" />@T("peopleTitle")</a>
    <p class="empty">@T("noMatch")</p>
}
else
{
    <PageTitle>@contact.Name · KanaanFlow</PageTitle>
    <a class="back-link" href="people"><Icon Name="back" Class="flip" Stroke="2.2" />@T("peopleTitle")</a>

    <section class="contact-head">
        <span class="avatar avatar-64" aria-hidden="true">@Fmt.Initial(contact.Name)</span>
        <span class="info">
            <h1 class="h1" style="font-size:24px">@contact.Name</h1>
            <span class="tag">@Books.PeopleCategoryName(contact.CategoryId)</span>
            @if (contact.Phone.Length > 0)
            {
                <a class="ltr" style="align-self:flex-start;font-size:16px" href="tel:@contact.Phone">@contact.Phone</a>
            }
        </span>
        @if (Books.CanRecord)
        {
            <button type="button" class="link-btn" aria-expanded="@(editing ? "true" : "false")" @onclick="StartEdit">@T("edit")</button>
        }
    </section>

    @if (editing)
    {
        <section class="add-panel">
            <label class="field">@T("personName")
                <input class="input" type="text" @bind="editName" @bind:event="oninput" />
            </label>
            <label class="field">@T("phone")
                <input class="input ltr" type="tel" @bind="editPhone" />
            </label>
            <span style="font-size:17px;font-weight:600">@T("category")</span>
            <div class="wrap">
                @foreach (PeopleCategory category in Book.PeopleCategories)
                {
                    PeopleCategory c = category;
                    <button type="button" class="sel chip" aria-pressed="@(editCategory == c.Id ? "true" : "false")" @onclick="() => editCategory = c.Id">@c.Name(Lang)</button>
                }
            </div>
            <div class="grid-2">
                <button type="button" class="btn btn-ghost" @onclick="() => editing = false">@T("cancel")</button>
                <button type="button" class="btn btn-primary" @onclick="SaveEditAsync">@T("save")</button>
            </div>
        </section>
    }

    @if (Books.CanRecord)
    {
        <div class="grid-2" style="margin-top:-6px">
            <a class="btn btn-in" style="height:64px;font-size:19px;border-radius:16px" href="add/in?contact=@contact.Id">@T("receivedFrom")</a>
            <a class="btn btn-out" style="height:64px;font-size:19px;border-radius:16px" href="add/out?contact=@contact.Id">@T("paidTo")</a>
        </div>
    }

    @if (openLoans.Count > 0)
    {
        <section class="section" style="gap:8px">
            <h2 class="h2" style="font-size:20px">@T("openLoans")</h2>
            @foreach (LoanStatus status in openLoans)
            {
                bool lent = status.Loan.Direction == LoanDirection.Lent;
                <a class="loan-pill @(lent ? "lent" : "borrowed")" style="text-decoration:none" href="loans?tab=@(lent ? "lent" : "borrowed")&open=@status.Loan.Id">
                    <span style="display:flex;flex-direction:column">
                        <span style="font-size:18px;font-weight:700">@(lent ? T("owesYou") : T("youOwe"))</span>
                        <span style="font-size:14px">@(lent ? T("owesYouHint") : T("youOweHint")) · @DueText(status.Loan)</span>
                    </span>
                    <Money Text="@Fmt.Money(status.Remaining)" Symbol="@Sym(status.Loan.Currency)" />
                </a>
            }
        </section>
    }

    <section class="section" style="gap:8px">
        <h2 class="h2" style="font-size:20px">@T("totals")</h2>
        <div class="list-card">
            <div class="tbl-head cols-3"><span>@T("currency")</span><span>@T("totalIn")</span><span>@T("totalOut")</span></div>
            @foreach (CurrencyTotals row in totals)
            {
                <div class="tbl-row cols-3"><span style="font-weight:700">@Sym(row.Currency)</span><span class="n c-in">@Fmt.Money(row.In)</span><span class="n c-out">@Fmt.Money(row.Out)</span></div>
            }
            @if (totals.Count == 0)
            {
                <p class="empty">@T("noActivity")</p>
            }
        </div>
    </section>

    <section class="section" style="gap:8px">
        <h2 class="h2" style="font-size:20px">@T("history")</h2>
        <div class="list-card">
            @foreach (Entry entry in history)
            {
                <EntryRow @key="entry.Id" Entry="entry" WithDate="true" ForContact="true" />
            }
            @if (history.Count == 0)
            {
                <p class="empty">@T("noActivity")</p>
            }
        </div>
    </section>

    <button type="button" class="btn btn-outline btn-tall" @onclick="StatementAsync"><Icon Name="doc" Size="22" />@T("statement")</button>
}

@code {
    private Contact? contact;
    private List<CurrencyTotals> totals = new List<CurrencyTotals>();
    private List<Entry> history = new List<Entry>();
    private List<LoanStatus> openLoans = new List<LoanStatus>();
    private bool editing;
    private string editName = string.Empty;
    private string editPhone = string.Empty;
    private string editCategory = PeopleCategory.OtherId;

    [Parameter]
    public string Id { get; set; } = string.Empty;

    protected override void OnParametersSet() => Compute();

    protected override bool ShouldRender()
    {
        Compute();
        return true;
    }

    private void Compute()
    {
        contact = Book.FindContact(Id);
        if (contact == null)
        {
            return;
        }

        totals = BookCalculator.ContactTotals(Book, contact.Id);
        history = Book.Entries.Where(e => e.ContactId == contact.Id && e.Type != EntryType.Exchange).ToList();
        openLoans = Book.Loans
            .Where(l => l.ContactId == contact.Id)
            .Select(l => BookCalculator.LoanStatusOf(Book, l, Today))
            .Where(s => s.IsOpen)
            .ToList();
    }

    private string DueText(Loan loan) => loan.DueDate.HasValue ? T("due") + " " + Books.DateText(loan.DueDate.Value) : T("noDue");

    private void StartEdit()
    {
        if (contact == null)
        {
            return;
        }

        editing = !editing;
        editName = contact.Name;
        editPhone = contact.Phone;
        editCategory = contact.CategoryId;
    }

    private async Task SaveEditAsync()
    {
        if (contact == null || editName.Trim().Length == 0)
        {
            return;
        }

        Contact updated = new Contact { Id = contact.Id, Name = editName.Trim(), Phone = editPhone.Trim(), CategoryId = editCategory };
        await Books.RecordAsync(new ContactSaved { Contact = updated });
        editing = false;
        Toasts.Show(T("saved") + " · " + updated.Name);
    }

    private async Task StatementAsync()
    {
        if (contact == null)
        {
            return;
        }

        PrintDocument doc = new PrintDocument { Title = T("statementTitle") + " · " + contact.Name };
        doc.MetaLines.Add(Books.PeopleCategoryName(contact.CategoryId) + (contact.Phone.Length > 0 ? " · " + contact.Phone : string.Empty));
        doc.MetaLines.Add(T("printedOn") + ": " + Fmt.LongDate(Today, Lang) + " · " + history.Count + " " + T("entriesN"));
        foreach (LoanStatus status in openLoans)
        {
            bool lent = status.Loan.Direction == LoanDirection.Lent;
            doc.MetaLines.Add((lent ? T("owesYou") : T("youOwe")) + ": " + Fmt.Money(status.Remaining) + " " + Sym(status.Loan.Currency) + " · " + DueText(status.Loan));
        }

        Export.AddTotals(doc, totals);
        doc.EntriesHeader.AddRange(new[] { T("date"), T("typeCol"), T("category"), T("noteCol"), T("amount"), T("recordedBy"), T("approval") });
        foreach (Entry entry in history)
        {
            doc.EntriesRows.Add(new List<string>
            {
                Books.DateText(entry.Date) + (entry.Time.Length > 0 ? " " + entry.Time : string.Empty),
                entry.Type == EntryType.In ? T("received") : T("paid"),
                Books.EntryCategoryName(entry.CategoryId),
                entry.Note,
                Fmt.Signed(entry.Amount, entry.Type == EntryType.In) + " " + Sym(entry.Currency),
                Books.MemberName(entry.CreatedBy),
                Export.ApprovalText(entry)
            });
        }

        await Export.PrintAsync(doc);
    }
}
