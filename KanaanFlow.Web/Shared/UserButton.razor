@inherits KfComponent
@inject SyncService Sync
@inject ApiClient Api
@inject LocalAuth Local

@* The logged-in user in the top bar: who you are, your role, password, admin panel and log out. *@
<button type="button" class="top-btn user-btn" aria-label="@T("user") · @Books.MyName" aria-haspopup="dialog" @onclick="() => open = true">
    <span class="avatar avatar-36" aria-hidden="true">@(Books.MyName.Length > 0 ? Fmt.Initial(Books.MyName) : string.Empty)</span>
</button>

<Sheet Open="open" Title="@T("user")" OnClose="Close">
    <div class="member" style="border:0">
        <span class="avatar avatar-48" aria-hidden="true">@Fmt.Initial(Books.MyName)</span>
        <span class="nm">@Books.MyName</span>
        <RoleBadge Role="Books.MyRole" />
    </div>

    @if (Books.IsAdmin)
    {
        <a class="btn btn-outline" href="more/admin" @onclick="Close"><Icon Name="shield" Size="22" />@T("adminPanel")</a>
    }

    <button type="button" class="link-btn" style="align-self:flex-start" aria-expanded="@(changingPassword ? "true" : "false")" @onclick="() => changingPassword = !changingPassword"><Icon Name="key" Size="20" />&nbsp;@T("changePassword")</button>
    @if (changingPassword)
    {
        <label class="field">@T("currentPassword")
            <input class="input" type="password" @bind="currentPassword" autocomplete="current-password" />
        </label>
        <label class="field">@T("newPassword")
            <input class="input" type="password" @bind="newPassword" autocomplete="new-password" />
        </label>
        <button type="button" class="btn btn-primary" disabled="@busy" @onclick="ChangePasswordAsync">@T("save")</button>
    }

    @if (confirmLogout)
    {
        <div class="add-panel" role="alert">
            <p style="font-size:16px;line-height:1.5">@T("logoutPending").Replace("{0}", Books.MyUnsyncedEvents().Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</p>
            <div class="grid-2">
                <button type="button" class="btn btn-ghost" @onclick="() => confirmLogout = false">@T("cancel")</button>
                <button type="button" class="btn btn-primary" @onclick="LogOutNowAsync">@T("logOut")</button>
            </div>
        </div>
    }
    else
    {
        <button type="button" class="btn btn-ghost" disabled="@busy" @onclick="LogOutAsync"><Icon Name="logout" Size="22" />@T("logOut")</button>
    }

    @if (error.Length > 0)
    {
        <p class="err-text" style="text-align:start" role="alert">@error</p>
    }
</Sheet>

@code {
    private bool open;
    private bool busy;
    private bool changingPassword;
    private bool confirmLogout;
    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string error = string.Empty;

    private void Close()
    {
        open = false;
        changingPassword = false;
        confirmLogout = false;
        error = string.Empty;
    }

    private async Task ChangePasswordAsync()
    {
        busy = true;
        error = string.Empty;
        try
        {
            if (newPassword.Length < LocalAuth.MinPasswordLength)
            {
                error = T("err-password-too-short");
            }
            else if (Books.Settings.SignedIn)
            {
                await Api.ChangePasswordAsync(currentPassword, newPassword);
            }
            else if (!await Local.ChangePasswordAsync(currentPassword, newPassword))
            {
                error = T("err-wrong-password");
            }

            if (error.Length == 0)
            {
                currentPassword = newPassword = string.Empty;
                changingPassword = false;
                Toasts.Show(T("saved"));
            }
        }
        catch (ApiException ex)
        {
            error = ErrorText.For(Books, ex.Code);
        }
        catch (HttpRequestException)
        {
            error = T("noConnection");
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LogOutAsync()
    {
        // Upload first when possible, so nothing waits on this device for the next log-in.
        if (Books.Settings.SignedIn && Books.MyUnsyncedEvents().Count > 0)
        {
            busy = true;
            await Sync.SyncNowAsync();
            busy = false;
        }

        if (Books.Settings.SignedIn && Books.MyUnsyncedEvents().Count > 0)
        {
            confirmLogout = true;
            return;
        }

        await LogOutNowAsync();
    }

    private async Task LogOutNowAsync()
    {
        Close();
        await Sync.LogOutAsync();
        Nav.NavigateTo("welcome", replace: true);
    }
}
