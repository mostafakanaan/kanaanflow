@* The KanaanFlow mark: a navy tile with a serif K and the three brand accents. *@
<svg class="@Class" viewBox="0 0 40 40" role="img" aria-label="KanaanFlow">
    <rect width="40" height="40" rx="12" fill="#1C2A6E"></rect>
    <text x="20" y="27" text-anchor="middle" font-family="Georgia, 'Times New Roman', serif" font-size="22" font-weight="700" fill="#FFFFFF">K</text>
    <rect x="8" y="30" width="7" height="3" rx="1.5" fill="#F2B705"></rect>
    <rect x="17" y="30" width="7" height="3" rx="1.5" fill="#E2384F"></rect>
    <rect x="26" y="30" width="7" height="3" rx="1.5" fill="#6E9BF2"></rect>
</svg>

@code {
    [Parameter]
    public string? Class { get; set; }
}
