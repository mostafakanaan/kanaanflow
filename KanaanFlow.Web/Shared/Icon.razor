@* Stroke icons from the design, drawn in the current text color. *@
<svg class="@Class" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="@Stroke" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "in":
            <path d="M12 4v11M6.5 10l5.5 5.5 5.5-5.5M5 20h14"></path>
            break;
        case "out":
            <path d="M12 20V9M6.5 14l5.5-5.5 5.5 5.5M5 4h14"></path>
            break;
        case "fx":
            <path d="M4 8h14l-3.5-3.5M20 16H6l3.5 3.5"></path>
            break;
        case "loan":
            <circle cx="9" cy="9" r="5.5"></circle><path d="M15.6 6.8a5.5 5.5 0 1 1-6.9 8.4"></path>
            break;
        case "back":
            <path d="M15 6l-6 6 6 6"></path>
            break;
        case "check":
            <path d="M5 12l5 5 9-10"></path>
            break;
        case "plus":
            <path d="M12 5v14M5 12h14"></path>
            break;
        case "search":
            <circle cx="11" cy="11" r="6.5"></circle><path d="M20 20l-4-4"></path>
            break;
        case "doc":
            <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"></path><path d="M14 3v5h5M9 13h6M9 17h4"></path>
            break;
        case "home":
            <path d="M3.5 11L12 4l8.5 7"></path><path d="M6 9.5V20h12V9.5"></path>
            break;
        case "people":
            <circle cx="9" cy="8" r="3.5"></circle><path d="M2.5 20c0-3.6 2.9-6 6.5-6s6.5 2.4 6.5 6"></path><path d="M16 4.6a3.5 3.5 0 0 1 0 6.8M21.5 20c0-2.8-1.6-4.9-4-5.7"></path>
            break;
        case "menu":
            <path d="M4 7h16M4 12h16M4 17h16"></path>
            break;
        case "backspace":
            <path d="M9 6h11v12H9l-6-6z"></path><path d="M13 10l4 4M17 10l-4 4"></path>
            break;
        case "trash":
            <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"></path>
            break;
        case "download":
            <path d="M12 4v11M7 10l5 5 5-5M5 20h14"></path>
            break;
        case "user":
            <circle cx="12" cy="8" r="4"></circle><path d="M4 21c0-4.4 3.6-7 8-7s8 2.6 8 7"></path>
            break;
        case "cloud":
            <path d="M7 18h10.5a4 4 0 0 0 .6-7.96A6 6 0 0 0 6.4 9.1 4.5 4.5 0 0 0 7 18z"></path>
            break;
        case "cloud-off":
            <path d="M7 18h10.5M20.6 15.4a4 4 0 0 0-2.5-5.36A6 6 0 0 0 9.5 5.6M6.4 9.1A4.5 4.5 0 0 0 7 18M3 3l18 18"></path>
            break;
        case "sync":
            <path d="M20 11a8 8 0 0 0-14.3-4.9L4 8M4 4v4h4M4 13a8 8 0 0 0 14.3 4.9L20 16M20 20v-4h-4"></path>
            break;
        case "logout":
            <path d="M15 4h3a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-3M10 16l-4-4 4-4M6 12h10"></path>
            break;
        case "shield":
            <path d="M12 3l8 3v6c0 4.5-3.4 8-8 9-4.6-1-8-4.5-8-9V6z"></path><path d="M9 12l2 2 4-4"></path>
            break;
        case "tag":
            <path d="M3 12V4h8l10 10-8 8z"></path><circle cx="7.5" cy="8.5" r="1.5"></circle>
            break;
        case "folder":
            <path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            break;
        case "wallet":
            <path d="M4 7h14a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a1 1 0 0 1-1-1V6a2 2 0 0 1 2-2h11v3"></path><path d="M16 13.5h.01"></path>
            break;
        case "settings":
            <circle cx="12" cy="12" r="3"></circle><path d="M12 2v3M12 19v3M4.2 4.2l2.1 2.1M17.7 17.7l2.1 2.1M2 12h3M19 12h3M4.2 19.8l2.1-2.1M17.7 6.3l2.1-2.1"></path>
            break;
        case "clock":
            <circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path>
            break;
        case "key":
            <circle cx="8" cy="15" r="4"></circle><path d="M11 12l9-9M16 7l3 3M14 9l2 2"></path>
            break;
        case "close":
            <path d="M6 6l12 12M18 6L6 18"></path>
            break;
        case "chevron":
            <path d="M9 6l6 6-6 6"></path>
            break;
        case "calendar":
            <rect x="3.5" y="5" width="17" height="15.5" rx="2.5"></rect>
            <path d="M3.5 10h17M8 3v4M16 3v4"></path>
            break;
    }
</svg>

@code {
    [Parameter, EditorRequired]
    public string Name { get; set; } = string.Empty;

    [Parameter]
    public int Size { get; set; } = 24;

    [Parameter]
    public double Stroke { get; set; } = 2;

    [Parameter]
    public string? Class { get; set; }
}
