@inherits KfComponent

@* For Accountants (and Admins): how many Owners' entries wait for approval, and a panel to approve them. *@
@if (Books.CanApprove)
{
    List<Entry> pending = Pending;
    <button type="button" class="top-btn approvals-btn @(pending.Count > 0 ? "has" : null)" aria-label="@T("approvals") · @pending.Count" aria-haspopup="dialog" @onclick="() => open = true">
        <Icon Name="shield" Size="24" />
        @if (pending.Count > 0)
        {
            <span class="badge" aria-hidden="true">@(pending.Count > 99 ? "99+" : pending.Count.ToString(System.Globalization.CultureInfo.InvariantCulture))</span>
        }
    </button>

    <Sheet Open="open" Title="@(T("awaitingApproval") + " (" + pending.Count + ")")" OnClose="Close">
        @if (pending.Count == 0)
        {
            <p class="empty"><Icon Name="check" Size="22" /> @T("nothingPending")</p>
        }
        else
        {
            <div class="list-card sheet-list">
                @foreach (Entry entry in pending)
                {
                    <EntryRow Entry="entry" WithDate="true" />
                }
            </div>

            @if (confirming)
            {
                <div class="add-panel" role="alert">
                    <p style="font-size:17px;font-weight:600;line-height:1.5">@Count("approveAllConfirm", pending.Count)</p>
                    <div class="grid-2">
                        <button type="button" class="btn btn-ghost" @onclick="() => confirming = false">@T("cancel")</button>
                        <button type="button" class="btn btn-in" disabled="@busy" @onclick="() => ApproveAllAsync(pending)">@Count("approveAllYes", pending.Count)</button>
                    </div>
                </div>
            }
            else
            {
                <button type="button" class="btn btn-in" @onclick="() => confirming = true"><Icon Name="check" Size="22" Stroke="2.6" />@Count("approveAll", pending.Count)</button>
            }
        }
    </Sheet>
}

@code {
    private bool open;
    private bool confirming;
    private bool busy;

    /// <summary>Entries this person may approve: Owners' entries without an approval, not their own. Newest first.</summary>
    private List<Entry> Pending => Book.Entries.Where(e => e.IsPendingApproval && e.CreatedBy != Books.Settings.MemberId).ToList();

    private string Count(string key, int count) => T(key).Replace("{0}", count.ToString(System.Globalization.CultureInfo.InvariantCulture));

    private void Close()
    {
        open = false;
        confirming = false;
    }

    private async Task ApproveAllAsync(List<Entry> entries)
    {
        busy = true;
        try
        {
            // One step: one local write and one upload for all of them.
            await Books.RecordAsync(entries.Select(e => (BookChange)new EntryApproved { EntryId = e.Id }).ToArray());
            Toasts.Show(Count("approvedN", entries.Count));
            Close();
        }
        finally
        {
            busy = false;
        }
    }
}
